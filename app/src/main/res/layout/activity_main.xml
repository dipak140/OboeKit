<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/textjni"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30dp"
        android:text="Oboe Tester"
        android:layout_marginBottom="100dp"/>

    <Button
        android:id="@+id/btnRecording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recording" />

    <Button
        android:id="@+id/btnEarback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Earback"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnPreviewPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preview Player"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnLivePlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Player"
        android:layout_marginTop="10dp" />

</LinearLayout>
